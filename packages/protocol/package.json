{
  "name": "@amrita/protocol",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Amrita's wire constitution: Zod event protocol, lane contract, RPC, and entity row schemas",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "ulid": "^2.3.0",
    "zod": "^4.4.3"
  }
}
