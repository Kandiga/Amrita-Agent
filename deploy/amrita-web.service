# Amrita web preview server — serves apps/web/dist and proxies the daemon from
# one origin (deploy/serve-web.mjs). __NODE__ and __DIR__ are substituted at
# install time. Holds no secret; the daemon's bearer token gates everything.
[Unit]
Description=Amrita web preview (static + daemon proxy)
# Wants= makes the After= ordering real. amritad's ExecStartPost health gate means
# this only starts once the daemon is actually listening, not merely spawned.
Wants=network-online.target
After=network-online.target amritad.service

[Service]
ExecStart=__NODE__ __DIR__/deploy/serve-web.mjs --port 7461
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
